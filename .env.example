# Environment Variables Example — Studio99 ERP Backend
# Copy this file to .env and fill in your values

# ─── Server ───────────────────────────────────────
NODE_ENV=development
PORT=5000
API_PREFIX=/api/v1

# ─── MongoDB ──────────────────────────────────────
MONGODB_URI=mongodb://127.0.0.1:27017/studio99_erp
# For Atlas: mongodb+srv://<username>:<password>@<cluster>.mongodb.net/studio99_erp?retryWrites=true&w=majority

# ─── JWT ──────────────────────────────────────────
JWT_ACCESS_SECRET=your_super_secret_access_key_change_in_production
JWT_REFRESH_SECRET=your_super_secret_refresh_key_change_in_production
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# ─── CORS ─────────────────────────────────────────
CORS_ORIGINS=http://localhost:8080,http://localhost:5173,http://localhost:3000

# ─── Rate Limiting ────────────────────────────────
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=100

# ─── Logging ──────────────────────────────────────
LOG_LEVEL=debug

# ─── App & Seed Defaults ──────────────────────────
APP_NAME=Studio99 ERP
DEFAULT_ADMIN_EMAIL=admin@studio99.com
DEFAULT_ADMIN_PASSWORD=Admin@123456
DEFAULT_BRANCH_NAME=Main Branch
