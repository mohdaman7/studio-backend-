# Environment Variables — Studio99 ERP Backend
# Copy this file to .env and fill in your values

# ─── Server ───────────────────────────────────────
NODE_ENV=development
PORT=5000
API_PREFIX=/api/v1

# ─── MongoDB ──────────────────────────────────────
MONGODB_URI=mongodb+srv://calculator_aman:mohdaman@cluster0.jloqp.mongodb.net/studio99-erp?retryWrites=true&w=majority
# For Atlas: mongodb+srv://user:password@cluster.mongodb.net/studio99_erp

# ─── JWT ──────────────────────────────────────────
JWT_ACCESS_SECRET=your_super_secret_access_key_change_in_production
JWT_REFRESH_SECRET=your_super_secret_refresh_key_change_in_production
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# ─── CORS ─────────────────────────────────────────
CORS_ORIGINS=http://localhost:3000,http://localhost:5173

# ─── Rate Limiting ────────────────────────────────
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=100

# ─── Logging ──────────────────────────────────────
LOG_LEVEL=debug

# ─── App ──────────────────────────────────────────
APP_NAME=Studio99 ERP
DEFAULT_ADMIN_EMAIL=admin@studio99.com
DEFAULT_ADMIN_PASSWORD=Admin@123456
DEFAULT_BRANCH_NAME=Main Branch
